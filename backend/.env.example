# ── Database ──
# For Supabase connection pooler, use port 5432 (Session Mode) with SQLAlchemy
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# ── Bhashini / IndicTTS ──
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ── ElevenLabs TTS ──
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
