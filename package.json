{
  "name": "smritisetu-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix client",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "npx -y concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build --prefix client",
    "test:frontend": "npm run test --prefix client",
    "test:backend": "npm run test --prefix backend",
    "test": "npm run test:frontend && npm run test:backend",
    "lint:frontend": "npm run lint --prefix client"
  }
}
